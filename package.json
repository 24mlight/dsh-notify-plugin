{
  "name": "dsh-notify",
  "version": "0.1.3",
  "description": "Notices for the DSH Android app: tells the phone when a Bot, a ds-bot group or a DSH Agent replies.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "notifications"
  ],
  "author": "24mlight",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/24mlight/dsh-notify-plugin.git"
  },
  "homepage": "https://github.com/24mlight/dsh-notify-plugin#readme"
}
